# Vertex AI Service Account credentials — required by api/_helpers.js (getVertexAI)
# Get these from: https://console.cloud.google.com/iam-admin/serviceaccounts
GCP_PROJECT_ID=your-gcp-project-id
GCP_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GCP_LOCATION=global

# PostgreSQL Database Configuration
# 1-usul: Yagona ulanish URL manzili (Neon.tech, Supabase, Railway yoki lokal Postgres)
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require"

# 2-usul: Alohida parametrlar (ixtiyoriy zaxira)
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=your_password
SQL_DB_NAME=ismlar_ai
SQL_SSL=false

