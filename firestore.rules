rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'akbarjonrovshanov13@gmail.com') ||
        request.auth.uid == 'admin_akbarjon'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['topic', 'fullScript', 'userId', 'createdAt']) &&
        data.topic is string && data.topic.size() <= 150 &&
        data.fullScript is string && data.fullScript.size() <= 2000 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.createdAt is string &&
        (!('hashtags' in data) || data.hashtags is list) &&
        (!('script' in data) || data.script is list) &&
        (!('imageUrls' in data) || data.imageUrls is list) &&
        (!('captionStyle' in data) || (data.captionStyle is string && data.captionStyle.size() <= 50)) &&
        (!('voice' in data) || (data.voice is string && data.voice.size() <= 50)) &&
        (!('likesCount' in data) || data.likesCount is number);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Videos collection
    match /videos/{videoId} {
      // Users can only read their own videos, unless admin or explicitly public
      allow read: if isSignedIn() && (
        isOwner(existing().userId) ||
        isAdmin() ||
        (resource.data.isPublic == true)
      );
      allow create: if isSignedIn() && isValidId(videoId) && isValidVideo(incoming());
      allow update: if isSignedIn() && isValidId(videoId) && (isOwner(existing().userId) || isAdmin()) && isValidVideo(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(videoId) && (isOwner(existing().userId) || isAdmin());
    }

    // User profile collection
    match /users/{userId} {
      // Users can only read their own profile, or admin can read any profile
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      // Users can create their own profile, admin can create any
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && isValidId(userId))
      );
      // Users can update their own profile (cannot increase credits or approve themselves), admin has full rights
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          (!('isApproved' in incoming()) || incoming().isApproved == existing().isApproved) &&
          (!('totalAllowed' in incoming()) || incoming().totalAllowed == existing().totalAllowed) &&
          (!('credits' in incoming()) || incoming().credits <= existing().credits)
        )
      );
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Payments collection
    match /payments/{paymentId} {
      // Users can only read their own payments, or admin can read all
      allow read: if isSignedIn() && (
        isAdmin() ||
        (existing().userId == request.auth.uid)
      );
      // Users can only submit new payments with PENDING status for themselves, admin can create any
      allow create: if isSignedIn() && isValidId(paymentId) && (
        isAdmin() ||
        (incoming().userId == request.auth.uid && incoming().status == 'PENDING')
      );
      // ONLY Admin can approve, reject or update payments
      allow update: if isSignedIn() && isAdmin();
      // ONLY Admin can delete payments
      allow delete: if isSignedIn() && isAdmin();
    }
  }
}
